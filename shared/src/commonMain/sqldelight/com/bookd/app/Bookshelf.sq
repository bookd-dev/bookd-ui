-- Bookshelf 表：缓存书架列表
CREATE TABLE BookshelfEntity (
    id INTEGER NOT NULL PRIMARY KEY,
    userId INTEGER NOT NULL,
    name TEXT NOT NULL,
    description TEXT,
    sortOrder INTEGER NOT NULL DEFAULT 0,
    bookCount INTEGER NOT NULL DEFAULT 0,
    isSystemDefault INTEGER NOT NULL DEFAULT 0,
    createdAt TEXT NOT NULL,
    updatedAt TEXT NOT NULL
);

-- BookshelfBook 表：缓存书架中的书籍（带阅读进度）
CREATE TABLE BookshelfBookEntity (
    bookshelfId INTEGER NOT NULL,
    bookId INTEGER NOT NULL,
    progressId INTEGER,
    progress REAL,
    currentPage INTEGER,
    totalPages INTEGER,
    lastReadAt TEXT,
    sortIndex INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (bookshelfId, bookId)
);

CREATE INDEX bookshelf_userId_index ON BookshelfEntity(userId);
CREATE INDEX bookshelf_book_bookshelfId_index ON BookshelfBookEntity(bookshelfId);

-- 获取所有书架
selectAll:
SELECT * FROM BookshelfEntity ORDER BY sortOrder ASC, id ASC;

-- 根据 ID 获取书架
selectById:
SELECT * FROM BookshelfEntity WHERE id = ?;

-- 获取默认书架（系统书架）
selectDefault:
SELECT * FROM BookshelfEntity WHERE isSystemDefault = 1 LIMIT 1;

-- 插入或替换书架
insertOrReplace:
INSERT OR REPLACE INTO BookshelfEntity (
    id, userId, name, description, sortOrder, bookCount,
    isSystemDefault, createdAt, updatedAt
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

-- 删除所有书架（用于刷新）
deleteAll:
DELETE FROM BookshelfEntity;

-- 根据 ID 删除书架
deleteById:
DELETE FROM BookshelfEntity WHERE id = ?;

-- 获取书架数量
count:
SELECT COUNT(*) FROM BookshelfEntity;

-- ==================== BookshelfBook Queries ====================

-- 获取书架中的书籍（分页，按 sortIndex 排序）
selectBooksInBookshelf:
SELECT
    bb.bookId,
    bb.progressId,
    bb.progress,
    bb.currentPage,
    bb.totalPages,
    bb.lastReadAt,
    b.*
FROM BookshelfBookEntity bb
INNER JOIN BookEntity b ON b.id = bb.bookId
WHERE bb.bookshelfId = :bookshelfId
ORDER BY bb.sortIndex ASC
LIMIT :limit OFFSET :offset;

-- 获取书架中的书籍数量
countBooksInBookshelf:
SELECT COUNT(*) FROM BookshelfBookEntity WHERE bookshelfId = ?;

-- 插入或替换书架书籍关联
insertOrReplaceBookshelfBook:
INSERT OR REPLACE INTO BookshelfBookEntity (
    bookshelfId, bookId, progressId, progress, currentPage, totalPages, lastReadAt, sortIndex
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

-- 删除书架中的所有书籍（用于刷新）
deleteBooksByBookshelfId:
DELETE FROM BookshelfBookEntity WHERE bookshelfId = ?;

-- 删除所有书架书籍关联
deleteAllBooks:
DELETE FROM BookshelfBookEntity;
